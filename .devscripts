DEBCHANGE_AUTO_NMU="no"
DEBCHANGE_RELEASE_HEURISTIC="changelog"
DEBCOMMIT_SIGN_TAGS="yes"
DEBDIFF_UNPACK_TARBALLS="no"
DEBDIFF_WDIFF_SOURCE_CONTROL="yes"
DEBEMAIL=myon@debian.org
DEBFULLNAME="Christoph Berg"
DEBSIGN_KEYID="5C48FE6157F49179597087C64C5A6BAB12D2A7AE"
DGET_VERIFY="no"
DSCVERIFY_KEYRINGS="$HOME/.gnupg/pubring.gpg"
RMADISON_URL_MAP_d="https://api.ftp-master.debian.org/madison"
RMADISON_URL_MAP_pgapt="https://pgdgbuild.dus.dg-i.net/repos/apt/madison/"
RMADISON_URL_MAP_u="https://qa.debian.org/cgi-bin/madison.cgi?table=ubuntu"
#USCAN_DOWNLOAD=no
USCAN_SYMLINK=rename
USCAN_VERBOSE=yes

SALSA_GROUP=postgresql
SALSA_TOKEN_FILE=~/.priv/pw/salsa-token
SALSA_IRKER=no
SALSA_KGB=yes
SALSA_CI_CONFIG_PATH=debian/gitlab-ci.yml
SALSA_EMAIL=yes
SALSA_EMAIL_RECIPIENTS=dispatch+%p_vcs@tracker.debian.org
SALSA_ENABLE_MR=yes
SALSA_ENABLE_ISSUES=yes
SALSA_TAGPENDING=yes
