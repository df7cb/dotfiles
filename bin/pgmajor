#!/bin/sh

set -eux

PGMAJOR="18"

if test -f debian/patches/series; then
    qpop -a || [ $? = 2 ]
fi
up

if ! grep "Upload for PostgreSQL $PGMAJOR" debian/changelog; then
    PACKAGE=$(dpkg-parsechangelog -SSource)
    BUG=$(grep "^$PACKAGE " ~/postgresql/bugs.$PGMAJOR | cut -d ' ' -f 2)
    if [ "$BUG" ]; then
        dch "Upload for PostgreSQL $PGMAJOR. (Closes: #$BUG)"
    else
        dch "Upload for PostgreSQL $PGMAJOR."
    fi
fi

if grep -q 'Architecture: any' debian/control.in && ! egrep "architecture-is-64-bit" debian/control.in; then
    sed -i -e '/Build-Depends:/a architecture-is-64-bit <!pkg.postgresql.32-bit>,' debian/control.in
    sed -i -e 's/^architecture-is-64-bit/ &/' debian/control.in
    dch "Restrict to 64-bit architectures."
fi

#if egrep "^[D ].*postgresql-PGVERSION" debian/control.in && ! grep -q 'postgresql-PGVERSIONS' debian/control.in; then
#    sed -i -e '/^[D ]/ s/postgresql-PGVERSION/${postgresql:Depends}/' debian/control.in
#    dch "Use \${postgresql:Depends}."
#fi

#if ! grep 'postgresql-.*all (>= 21.' debian/control.in; then
#	sed -i -e 's/postgresql[^,]*-all[^,]*/postgresql-all (>= 217~)/' debian/control*
#	if grep loop debian/rules; then
#		sed -i -e 's/	dh $@/	dh $@ --with pgxs_loop/' debian/rules
#		dch "Use dh --with pgxs_loop."
#	else
#		sed -i -e 's/	dh $@/	dh $@ --with pgxs/' debian/rules
#		dch "Use dh --with pgxs."
#	fi
#fi

if grep -q "postgresql-all" debian/control.in && ! grep -q nocheck debian/control.in; then
    sed -i -e 's/postgresql-all.*/postgresql-server-dev-all,\n postgresql-all <!nocheck>,/' debian/control.in
    dch "Mark postgresql-all as <!nocheck>."
fi

if ! grep -q postgresql:Breaks debian/control.in; then
    sed -i -e '/^Description:/ i Breaks:\n ${postgresql:Breaks},' debian/control.in
    dch "Add \${postgresql:Breaks}."
fi

if ! grep '^Standards-Version: 4.7.2' debian/control*; then
	sed -i -e 's/^Standards-Version:.*/Standards-Version: 4.7.2/' debian/control*
fi

if grep '^Rules-Requires-Root: no' debian/control*; then
	sed -i -e '/^Rules-Requires-Root: no/d' debian/control*
fi

if ! grep 'debhelper-compat (= 13)' debian/control*; then
	sed -i -e 's/debhelper[^,]*/debhelper-compat (= 13)/' debian/control*
	v rm debian/compat || :
	dch "DH 13."
fi

if grep -w make debian/tests/control; then
	sed -i -e 's/make/postgresql-common-dev/' debian/tests/control*
	dch "debian/tests: Depend on postgresql-common-dev instead of 'make'."
fi

if grep supported-versions debian/tests/*; then
	sed -i -e 's/supported-versions/FIXME installed-versions/g' debian/tests/*
	dch "debian/tests: Use installed-versions instead of supported-versions."
fi

if grep 'github.*/releases' debian/watch; then
	sed -i 's!/releases!/tags!' debian/watch
	dch "debian/watch: Look at GitHub tags instead of releases."
fi

for file in debian/control.in debian/tests/control*; do
    wrap-and-sort -ast -f $file
done

pg_buildext updatecontrol

if grep UNRELEASED debian/changelog; then
	EDITOR=touch dch -r --distribution unstable
	rm -f '+1'
fi

vi debian/changelog debian/rules debian/control.in debian/tests/*

git diff

upload -s
