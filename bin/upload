#!/bin/sh

set -eu

CLEAN=yes
GIT=git
PACKAGE=$(dpkg-parsechangelog -SSource)
BUILD_BINARY="yes"
BUILD_SOURCE="yes"

while getopts "ce:gh:sS" opt ; do
  case $opt in
    c) CLEAN="" ;;
    e) DELAYED="$OPTARG" ;;
    g) GIT="" ;;
    h) UPLOAD_HOST="$OPTARG" ;;
    s) BUILD_SOURCE="" ;;
    S) BUILD_BINARY="" ;;
    *) exit 5 ;;
  esac
done
# shift away args
shift $(($OPTIND - 1))

ask () {
    echo
    read -p "$1 " reply
    case $reply in
        n) return 1 ;;
        *) return 0 ;;
    esac
}

distribution=$(dpkg-parsechangelog -Sdistribution)
if [ "$distribution" = "UNRELEASED" ]; then
  echo "Distribution is UNRELEASED. Fix that before uploading."
  exit 1
fi

S_V=$(dpkg-query --show --showformat '${Version}' debian-policy || :)
S_V=${S_V%.*}
if ! grep -q "^Standards-Version: $S_V" debian/control; then
    grep "^Standards-Version:" debian/control
    ask "Bump Standards-Version?" && sed -i -e "s/^Standards-Version: .*/Standards-Version: $S_V/" debian/control*
fi

if grep -q "version=" debian/watch; then
    cat debian/watch
    if ask "Upgrade debian/watch?"; then
        uscan --update-watchfile || :
        vi debian/watch
    fi
fi

[ "$CLEAN" ] && dclean
if [ -d debian/patches ]; then
    qpop -a || [ $? = 2 ]
fi

if [ "$BUILD_BINARY" ]; then
    ask "Build binaries?" && dbp "$@"
fi

if [ "$BUILD_SOURCE" ]; then
    ask "Build source?" && dbp -S "$@"
fi

changes=$(ls -t ../*.changes | head -1)
printf '\e[1;34m'
ls -l $changes
printf '\e[0;34m'
cat $changes
printf '\e[0m'

echo
[ -d .git ] && git --no-pager status

# sanity checks
if grep FIXME debian/control*; then
  printf '\e[1;31mFIXME in debian/control\e[0m\n'
fi
if [ ! -f debian/gitlab-ci.yml ] && [ ! -f debian/salsa-ci.yml ]; then
  printf '\e[1;31mNo debian/gitlab-ci.yml found\e[0m\n'
fi
if [ -f debian/watch ] && grep -q /releases debian/watch; then
  printf '\e[1;31mdebian/watch references /releases instead of /tags\e[0m\n'
fi
case $changes in
  *_source*) ;;
  *) printf '\e[1;31mArchitecture-dependant changes file\e[0m\n'
     ;;
esac

export GPG_TTY="$(tty)"
gpg-connect-agent updatestartuptty /bye > /dev/null

if [ "$GIT" ] && ask "$PACKAGE: Push?"; then
  echo -n "git pull ... "
  git pull --ff-only

  if git status -s | grep -q '^[^?]. debian/'; then
    git add -u debian
    debcommit
  fi

  git debpush

  grep -E '^Vcs|^Homepage' debian/control || :
  if grep -q postgres debian/control*; then
    URL="https://jengus.postgresql.org/job/$PACKAGE/build"
    printf "\e[1m$URL\e[0m\n"
    x-www-browser "$URL" &
    #URL="http://10.0.0.35:8080/job/deb-$PACKAGE/build"
    #printf "\e[1m$URL\e[0m\n"
    #firefox -P cybertec $URL &
  fi
fi

if ask "$PACKAGE: Upload to $distribution?"; then
    if [ "$GIT" ]; then
        version=$(dpkg-parsechangelog -SVersion)
        tag="debian/$(echo $version | tr ':~' '%_')"
        if ! git tag | grep -q "^$tag$"; then
            ( set -x; git tag -s -m "tagging $PACKAGE $version" "$tag" )
        fi
        echo -n "git push ... "
        git push
    fi
    set -x
    debsign $changes
    dput ${DELAYED:+-e $DELAYED} ${UPLOAD_HOST:-} $changes
fi
