#!/bin/sh

if [ -S "${SSH_AUTH_SOCK:-}" ] && [ "$SSH_AUTH_SOCK" != "$HOME/.ssh/auth_sock" ]; then
  rm -f "$HOME/.ssh/auth_sock"
  ln -s "$SSH_AUTH_SOCK" "$HOME/.ssh/auth_sock"
  SSH_AUTH_SOCK="$HOME/.ssh/auth_sock"
fi

if command -v tmux > /dev/null; then
    exec tmux new -A "$@"
else
    exec screen -R "$@"
fi
