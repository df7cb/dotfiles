#!/bin/sh

set -eu

ask () {
    echo
    read -p "$1 " reply
    case $reply in
        n) return 1 ;;
        *) return 0 ;;
    esac
}

if [ "${1:-}" != "-c" ]; then
    if test -d debian/patches; then
        quilt pop -a || [ $? = 2 ]
    fi
    dclean
    git checkout debian/control
fi

up

if grep -q "version=" debian/watch; then
    cat debian/watch
    if ask "Upgrade debian/watch?"; then
        uscan --update-watchfile || :
        vi debian/watch
    fi
fi

# gbp repo
if git ls | grep -qv '^debian/'; then
    git uscan

# debian/ repo
else
    uscan
    tarball=$(ls -v ../*.orig.tar.* | tail -n1)
    tarball=${tarball##*_}
    version=${tarball%.orig.tar.*}

    oldepoch=$(dpkg-parsechangelog -SVersion | grep -o '[0-9]*:' || :)

    dch -v "$oldepoch$version-1" "New upstream version $version."
fi

dch -r

origtargz -u
if test -d debian/patches; then
    quilt push -a || [ $? = 2 ]
fi

upload
